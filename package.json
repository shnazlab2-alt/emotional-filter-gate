{
  "name": "emotional-filter-gate",
  "version": "1.0.0",
  "description": "Configurable emotional filter gate for content pipelines: sentiment ensemble, threshold evaluation, ambiguity handling, and decision routing. Zero runtime dependencies.",
  "keywords": [
    "sentiment",
    "moderation",
    "content-filter",
    "pipeline",
    "gate",
    "valence",
    "safety",
    "typescript"
  ],
  "license": "MIT",
  "author": "Jeffrey Schnaus",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build && npm run lint:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  }
}
